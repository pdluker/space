{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "space",
  "main": "index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/data.json"]
  },
  "kv_namespaces": [
    {
      "binding": "SPACE_KV",
	"id": "6ceb0fea2ef3468c9709e9335455f4cd"
    }
  ],
  "routes": [
    {
      "pattern": "space.stluker.com",
      "custom_domain": true
    }
  ]
}
